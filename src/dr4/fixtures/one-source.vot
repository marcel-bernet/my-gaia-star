<?xml version='1.0' encoding='UTF-8'?>
<VOTABLE xmlns="http://www.ivoa.net/xml/VOTable/v1.3" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" version="1.4" xsi:schemaLocation="http://www.ivoa.net/xml/VOTable/v1.3 http://www.ivoa.net/xml/VOTable/v1.3">
<RESOURCE type="results" utype="spec:Spectrum">
<TIMESYS ID="time_frame" refposition="BARYCENTER" timeorigin="2455197.5" timescale="TCB" /><TABLE>
<PARAM arraysize="49" datatype="char" name="citation" ucd="meta.bib" value="https://www.cosmos.esa.int/web/gaia-users/credits">
<DESCRIPTION>How to cite and acknowledge Gaia:</DESCRIPTION>
</PARAM>
<PARAM arraysize="12" datatype="char" name="release" ucd="meta.version" value="Gaia DR4_RC3">
<DESCRIPTION>Gaia Data Release</DESCRIPTION>
</PARAM>
<PARAM arraysize="49" datatype="char" name="help" ucd="meta.ref.url" value="https://www.cosmos.esa.int/web/gaia-users/archive">
<DESCRIPTION>Tutorials, documentation, and help:</DESCRIPTION>
</PARAM>
<PARAM arraysize="54" datatype="char" name="issues" ucd="meta.ref.url" value="https://www.cosmos.esa.int/web/gaia-users/known-issues">
<DESCRIPTION>Known issues in the data:</DESCRIPTION>
</PARAM>
<PARAM arraysize="47" datatype="char" name="data" ucd="meta.ref.url" value="https://www.cosmos.esa.int/web/gaia/data-access">
<DESCRIPTION>Gaia data:</DESCRIPTION>
</PARAM>
<PARAM arraysize="56" datatype="char" name="terms" ucd="meta.ref.url" value="https://www.cosmos.esa.int/web/esdc/terms-and-conditions">
<DESCRIPTION>Terms and conditions for use of Gaia data:</DESCRIPTION>
</PARAM>
<PARAM arraysize="35" datatype="char" name="home" ucd="meta.ref.url" value="https://www.cosmos.esa.int/web/gaia">
<DESCRIPTION>Gaia mission home:</DESCRIPTION>
</PARAM>
<PARAM arraysize="13" datatype="char" name="publisher" ucd="meta.id;meta.curation" value="ESA/Gaia/DPAC">
<DESCRIPTION>Dataset publisher</DESCRIPTION>
</PARAM>
<PARAM arraysize="18" datatype="char" name="creator" ucd="meta.ref" value="Gaia Collaboration">
<DESCRIPTION>Dataset creator</DESCRIPTION>
</PARAM>
<FIELD datatype="long" name="solution_id" ucd="meta.version">
<DESCRIPTION>Solution Identifier</DESCRIPTION>
</FIELD>
<FIELD datatype="long" name="source_id" ucd="meta.id;meta.main">
<DESCRIPTION>Unique source identifier</DESCRIPTION>
</FIELD>
<FIELD datatype="long" name="transit_id" ucd="meta.id.assoc">
<DESCRIPTION>Transit Identifier</DESCRIPTION>
</FIELD>
<FIELD datatype="double" name="ra0" ucd="pos.eq.ra" unit="deg">
<DESCRIPTION>Right ascension of reference point</DESCRIPTION>
</FIELD>
<FIELD datatype="double" name="dec0" ucd="pos.eq.dec" unit="deg">
<DESCRIPTION>Declination of reference point</DESCRIPTION>
</FIELD>
<FIELD datatype="float" name="agis_source_excess_noise" ucd="stat.param" unit="mas">
<DESCRIPTION>the unscaled AGIS Source Excess Noise</DESCRIPTION>
</FIELD>
<FIELD arraysize="*" datatype="long" name="obs_time_tcb" ucd="time.epoch" unit="ns">
<DESCRIPTION>effective observing time as TCB</DESCRIPTION>
</FIELD>
<FIELD datatype="float" name="obs_time_bary_corr" ucd="time.epoch;arith.diff" unit="ns">
<DESCRIPTION>barycentric correction to obsTimeTcb</DESCRIPTION>
</FIELD>
<FIELD arraysize="*" datatype="double" name="scan_pos_angle" ucd="pos.posAng" unit="deg">
<DESCRIPTION>Position angle of the scan</DESCRIPTION>
</FIELD>
<FIELD datatype="float" name="zeta" ucd="instr.offset;pos.posAng" unit="deg">
<DESCRIPTION>across-scan field angle zeta of the reference point (ra0, dec0)</DESCRIPTION>
</FIELD>
<FIELD datatype="float" name="parallax_factor_al" ucd="obs.param">
<DESCRIPTION>Parallax factor AL</DESCRIPTION>
</FIELD>
<FIELD datatype="float" name="parallax_factor_ac" ucd="obs.param">
<DESCRIPTION>Parallax factor AC</DESCRIPTION>
</FIELD>
<FIELD arraysize="*" datatype="float" name="colour_factor_al" ucd="arith.factor;phot.color">
<DESCRIPTION>colour factor AL</DESCRIPTION>
</FIELD>
<FIELD arraysize="*" datatype="float" name="colour_factor_ac" ucd="arith.factor;phot.color">
<DESCRIPTION>colour factor AC</DESCRIPTION>
</FIELD>
<FIELD datatype="float" name="nu_eff_used_in_astrometry" ucd="em.wavenumber;em.opt" unit="um**-1">
<DESCRIPTION>colour (i.e. effective wavenumber) used in AGIS (and in IPD)</DESCRIPTION>
</FIELD>
<FIELD datatype="float" name="nu_eff_error" ucd="stat.error;em.wavenumber;em.opt" unit="um**-1">
<DESCRIPTION>standard error of nuEffUsedInAstrometry</DESCRIPTION>
</FIELD>
<FIELD arraysize="*" datatype="double" name="centroid_pos_al" ucd="pos.angDistance" unit="mas">
<DESCRIPTION>Local plane coordinate (w) of image centroid AL</DESCRIPTION>
</FIELD>
<FIELD arraysize="*" datatype="double" name="centroid_pos_ac" ucd="pos.angDistance" unit="mas">
<DESCRIPTION>Local plane coordinate (z) of image centroid AC</DESCRIPTION>
</FIELD>
<FIELD arraysize="*" datatype="double" name="calculated_pos_ac" ucd="pos.angDistance" unit="mas">
<DESCRIPTION>Calculated Local plane coordinate (z)</DESCRIPTION>
</FIELD>
<FIELD arraysize="*" datatype="float" name="centroid_pos_error_al" ucd="stat.error;pos.angDistance" unit="mas">
<DESCRIPTION>standard error of centroidPosAl</DESCRIPTION>
</FIELD>
<FIELD arraysize="*" datatype="float" name="centroid_pos_error_ac" ucd="stat.error;pos.angDistance" unit="mas">
<DESCRIPTION>standard error of centroidPosAc</DESCRIPTION>
</FIELD>
<FIELD arraysize="*" datatype="boolean" name="used_by_agis_al" ucd="meta.code.status">
<DESCRIPTION>whether the CCD transit was used in AL by AGIS-DR4</DESCRIPTION>
</FIELD>
<FIELD arraysize="*" datatype="boolean" name="used_by_agis_ac" ucd="meta.code.status">
<DESCRIPTION>whether the CCD transit was used in AC by AGIS-DR4</DESCRIPTION>
</FIELD>
<FIELD datatype="short" name="transit_acq_flags" ucd="meta.code.qual">
<DESCRIPTION>Transit-level information on the on-board acquisition</DESCRIPTION>
</FIELD>
<FIELD datatype="short" name="transit_proc_flags" ucd="meta.code.qual">
<DESCRIPTION>Transit-level information on the processing results</DESCRIPTION>
</FIELD>
<FIELD arraysize="*" datatype="short" name="ccd_proc_flags" ucd="meta.code.qual">
<DESCRIPTION>CCD-level information on the processing results</DESCRIPTION>
</FIELD>
<FIELD datatype="boolean" name="multipeak" ucd="meta.code.status">
<DESCRIPTION>True if the AstroElementary is multipeak; false otherwise</DESCRIPTION>
</FIELD>
<FIELD datatype="boolean" name="blended" ucd="meta.code.status">
<DESCRIPTION>True if the peak for this source is also matched to another source</DESCRIPTION>
</FIELD>
<FIELD arraysize="*" datatype="float" name="ipd_error_al" ucd="stat.error;pos.angDistance" unit="mas">
<DESCRIPTION>standard error of IDU IPD centroid AL</DESCRIPTION>
</FIELD>
<FIELD arraysize="*" datatype="float" name="ipd_error_ac" ucd="stat.error;pos.angDistance" unit="mas">
<DESCRIPTION>standard error of IDU IPD centroid AC (NaN for 1d windows)</DESCRIPTION>
</FIELD>
<FIELD datatype="float" name="g_mag" ucd="phot.mag;em.opt" unit="mag">
<DESCRIPTION>G Magnitude, either from CU5 or from on-board estimate</DESCRIPTION>
</FIELD>
<FIELD datatype="short" name="g_class" ucd="obs.param">
<DESCRIPTION>Window class used in SM, AF and XP</DESCRIPTION>
</FIELD>
<FIELD arraysize="*" datatype="short" name="gates" ucd="obs.param">
<DESCRIPTION>Gate information for all CCDs</DESCRIPTION>
</FIELD>
<FIELD arraysize="*" datatype="float" name="source_dist_to_last_ci" ucd="obs.param" unit="pixel">
<DESCRIPTION>source distance to last charge injection</DESCRIPTION>
</FIELD>
<FIELD datatype="float" name="ac_rate" ucd="obs.param" unit="pixel.s**-1">
<DESCRIPTION>AstroElementary AC rates for the transit time</DESCRIPTION>
</FIELD>
<FIELD arraysize="*" datatype="float" name="sub_pixel_coord" ucd="obs.param" unit="pixel">
<DESCRIPTION>Subpixel coordinate AL</DESCRIPTION>
</FIELD>
<FIELD arraysize="*" datatype="float" name="mu" ucd="obs.param" unit="pixel">
<DESCRIPTION>Ac coordinate of the image (or window centre) on a CCD</DESCRIPTION>
</FIELD>
<DATA>
<BINARY2>
<STREAM encoding="base64"></STREAM>
</BINARY2>
</DATA>
</TABLE>
</RESOURCE>
</VOTABLE>